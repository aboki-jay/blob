// Blob's feedback relay. See README.md in this folder for how to deploy it.
{
  "name": "blob-feedback",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-26",

  // The relay's public address. The default workers.dev address is switched
  // off, because it carries the Cloudflare account's name.
  // The second entry is needed because the domain's own website claims every
  // subdomain with a catch-all route; a route naming this one exactly wins.
  "routes": [
    { "pattern": "blob-feedback.davidokunlola.com", "custom_domain": true },
    { "pattern": "blob-feedback.davidokunlola.com/*", "zone_name": "davidokunlola.com" }
  ],
  "workers_dev": false,
  "preview_urls": false,

  // Cloudflare Email Sending. The domain in FEEDBACK_FROM must be onboarded for it.
  "send_email": [{ "name": "EMAIL" }],

  // At most 5 messages a minute from one sender.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],

  "vars": {
    "FEEDBACK_FROM": "feedback@blob.davidokunlola.com"
  }

  // FEEDBACK_TO (the inbox feedback is delivered to) is a secret, set with:
  //   npx wrangler secret put FEEDBACK_TO
  // It is deliberately not written here, so the address is not public.
}
