{
  "name": "blob",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source Chrome extension for persistent, Figma-style comments on any website.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "wxt build --mode e2e",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build:e2e && playwright test",
    "check": "npm run typecheck && npm run test && npm run build && npm run check:manifest && npm run check:worker",
    "postinstall": "wxt prepare",
    "test:e2e:harness": "wxt build && playwright test -c playwright.harness.config.ts",
    "icons": "node scripts/make-icons.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:worker": "node scripts/check-worker.mjs",
    "test:load": "node scripts/load-test.ts",
    "screenshots": "wxt build && node scripts/screenshots.mjs && node scripts/popup-screenshots.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",
    "wxt": "^0.21.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
